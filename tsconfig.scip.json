{
  "include": ["bin/**/*.js", "src/**/*.js", "scripts/**/*.js", "scripts/**/*.cjs"],
  "compilerOptions": {
    "noEmit": true,
    "checkJs": false,
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "moduleResolution": "Node",
    "module": "CommonJS",
    "target": "ES2020"
  }
}
